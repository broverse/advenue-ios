{
  "name": "with requireConsent, a withdrawal keeps a still-queued install without its identifiers and a grant re-sends it once, with the same id and timestamp and fresh identifiers",
  "source": "docs/superpowers/specs/2026-11-07-security-audit-run2-followups-design.md U2 (case 1, and Review Focus 4 of its plan: withdraw, grant, withdraw, grant sends exactly one install). The other buffered events are still dropped, as run-2 D6 requires; the install is the one exception.",
  "kind": "consent",
  "requireConsent": true,
  "steps": [
    { "op": "setConsent", "granted": true },
    { "op": "setUserId", "id": "user-1" },
    { "op": "setAdvertisingId", "id": "ad-1" },
    { "op": "trackInstall", "expectAccepted": true },
    { "op": "track", "name": "a", "expectAccepted": true },
    { "op": "rememberPendingInstall" },
    { "op": "expectPending", "count": 2 },
    { "op": "advanceClock", "ms": 60000 },
    { "op": "setConsent", "granted": false },
    { "op": "expectPending", "count": 0 },
    { "op": "expectStoredQueue", "count": 0 },
    {
      "op": "expectDeferredInstall",
      "present": true,
      "absentFields": [
        "idfa",
        "gaid",
        "vendorId",
        "androidId",
        "appInstanceId",
        "customerUserId",
        "consent",
        "attestationToken",
        "attestationType",
        "attestationKeyId",
        "attestationChallenge",
        "pushToken",
        "pushProvider"
      ]
    },
    { "op": "flush" },
    { "op": "expectRequests", "count": 0 },
    { "op": "setConsent", "granted": true },
    { "op": "expectPending", "count": 1 },
    { "op": "expectDeferredInstall", "present": false },
    { "op": "setConsent", "granted": false },
    { "op": "expectPending", "count": 0 },
    { "op": "expectDeferredInstall", "present": true },
    { "op": "setUserId", "id": "user-2" },
    { "op": "setAdvertisingId", "id": "ad-2" },
    { "op": "setConsent", "granted": true },
    { "op": "flush" },
    { "op": "expectRequests", "count": 1 },
    { "op": "expectSentInstalls", "count": 1, "userId": "user-2", "advertisingId": "ad-2" },
    { "op": "trackInstall", "expectAccepted": false },
    { "op": "setConsent", "granted": false },
    { "op": "expectDeferredInstall", "present": false },
    { "op": "setConsent", "granted": true },
    { "op": "flush" },
    { "op": "expectSentInstalls", "count": 1 },
    { "op": "relaunch" },
    { "op": "trackInstall", "expectAccepted": false },
    { "op": "flush" },
    { "op": "expectSentInstalls", "count": 1 }
  ]
}
